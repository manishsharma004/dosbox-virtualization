{
  "name": "dosbox-virtualization",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Full MS-DOS virtualization in the browser (js-dos / DOSBox) with a filesystem, desktop + mobile UX, and pre-installed freeware Turbo C++ 1.01 and the original Dangerous Dave. Deployed to GitHub Pages.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor": "node scripts/fetch-vendor.mjs",
    "bundle": "node scripts/build-bundle.mjs",
    "prepare:dos": "npm run vendor && npm run bundle",
    "predev": "node scripts/build-bundle.mjs --if-needed",
    "dev": "vite",
    "prebuild": "node scripts/build-bundle.mjs --if-needed",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-dos": "8.4.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^2.1.0",
    "yazl": "^3.3.1"
  }
}
